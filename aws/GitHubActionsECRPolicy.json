{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "EcrLogin",
			"Effect": "Allow",
			"Action": "ecr:GetAuthorizationToken",
			"Resource": "*"
		},
		{
			"Sid": "EcrPushFiapRepos",
			"Effect": "Allow",
			"Action": [
				"ecr:BatchCheckLayerAvailability",
				"ecr:InitiateLayerUpload",
				"ecr:UploadLayerPart",
				"ecr:CompleteLayerUpload",
				"ecr:PutImage",
				"ecr:BatchGetImage"
			],
			"Resource": "arn:aws:ecr:us-east-1:*:repository/fiap/*"
		}
	]
}
